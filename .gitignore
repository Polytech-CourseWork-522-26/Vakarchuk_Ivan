# ======= Залежності та Бібліотеки =======
# Ігноруємо завантажені бібліотеки, якщо вони качаються через менеджери пакунків
# АБО якщо ти вручну тримаєш там великі бінарники.
# Примітка: якщо у тебе є папка з сирцями бібліотек (наприклад, include/), 
# її зазвичай комітять, а от зібрані .lib/.a/.dll файли — ігнорують.
vcpkg_installed/
.vcpkg-root
vcpkg/
course/libs/
# Якщо твої ліби лежать у конкретній папці, наприклад "libs", і ти не хочеш їх пушити:
# libs/

